# ---------------------------------------------------------------------------
# CloudGuard AI — environment variables
#
# Every value here is optional. Copy this file to .env if you want to override
# something; the application runs correctly with no .env file at all.
# ---------------------------------------------------------------------------

# Reasoning layer. "demo" uses the built-in deterministic agent and needs no
# key. Set to "anthropic" or "openai" only if you also supply AI_API_KEY.
AI_PROVIDER=demo

# Leave empty for the hackathon demo. The application MUST work without it.
AI_API_KEY=

# Optional model override when AI_PROVIDER is anthropic or openai.
AI_MODEL=

# Backend HTTP port inside the container.
PORT=5000

# Host ports the containers publish on. Change these if something else on your
# machine already owns 3000 or 5000 (Docker will refuse to start otherwise).
FRONTEND_PORT=3000
BACKEND_PORT=5000

# How old a service observation may be before the safety engine refuses to make
# a capacity decision from it.
DATA_FRESHNESS_THRESHOLD_MINUTES=15
